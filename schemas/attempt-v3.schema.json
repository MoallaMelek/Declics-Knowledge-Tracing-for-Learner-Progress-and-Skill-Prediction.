{
  "$defs": {
    "ObservationV3": {
      "additionalProperties": false,
      "properties": {
        "skill_id": {
          "enum": [
            "pitch",
            "rhythm",
            "timing",
            "score_navigation",
            "quality",
            "articulation",
            "technique",
            "fingering",
            "omr_metadata",
            "corrective_feedback",
            "posture_context",
            "instrument_context"
          ],
          "title": "Skill Id",
          "type": "string"
        },
        "producer_axis": {
          "maximum": 7,
          "minimum": 1,
          "title": "Producer Axis",
          "type": "integer"
        },
        "producer_version": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        },
        "objective_id": {
          "maxLength": 10,
          "minLength": 1,
          "title": "Objective Id",
          "type": "string"
        },
        "assessment_kind": {
          "enum": [
            "direct",
            "inferred",
            "recommendation",
            "context"
          ],
          "title": "Assessment Kind",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "source_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Confidence"
        },
        "missing": {
          "default": false,
          "title": "Missing",
          "type": "boolean"
        },
        "reference_compared": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Compared"
        },
        "error_types": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Error Types",
          "type": "array"
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        }
      },
      "required": [
        "skill_id",
        "producer_axis",
        "producer_version",
        "objective_id",
        "assessment_kind"
      ],
      "title": "ObservationV3",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.0",
      "default": "3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "objective_mapping_version": {
      "const": "cached-objectives-1-1",
      "default": "cached-objectives-1-1",
      "title": "Objective Mapping Version",
      "type": "string"
    },
    "attempt_id": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "student_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Student Id",
      "type": "string"
    },
    "session_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "exercise_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Exercise Id",
      "type": "string"
    },
    "instrument": {
      "maxLength": 50,
      "minLength": 1,
      "title": "Instrument",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "provenance": {
      "enum": [
        "synthetic",
        "project",
        "public"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "rubric_version": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Rubric Version",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/ObservationV3"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    }
  },
  "required": [
    "attempt_id",
    "student_id",
    "session_id",
    "exercise_id",
    "instrument",
    "timestamp",
    "provenance",
    "rubric_version",
    "observations"
  ],
  "title": "AttemptV3",
  "type": "object"
}
