{
  "additionalProperties": false,
  "properties": {
    "learner_id": {
      "pattern": "^learner_[a-f0-9]{16}$",
      "title": "Learner Id",
      "type": "string"
    },
    "consent_version": {
      "pattern": "^[a-zA-Z0-9_.-]{1,40}$",
      "title": "Consent Version",
      "type": "string"
    },
    "granted": {
      "const": true,
      "title": "Granted",
      "type": "boolean"
    },
    "retention_days": {
      "default": 30,
      "maximum": 365,
      "minimum": 1,
      "title": "Retention Days",
      "type": "integer"
    }
  },
  "required": [
    "learner_id",
    "consent_version",
    "granted"
  ],
  "title": "Consent",
  "type": "object"
}